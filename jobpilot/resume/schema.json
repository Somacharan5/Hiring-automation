{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JobPilot resume data",
  "description": "Content for the exact-format resume. Layout is fixed in template.html; only this data changes. Any text field supports inline markup: **bold**, *italic*, and [label](url). Links on a heading use the item's `href`.",
  "type": "object",
  "required": ["name", "contacts", "experience"],
  "properties": {
    "name": { "type": "string", "description": "Full name, shown centered at the top." },
    "contacts": {
      "type": "array",
      "description": "Header contact line, joined by ' | ' in order. A null href renders as plain text (e.g. phone).",
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string" },
          "href": { "type": ["string", "null"] }
        }
      }
    },
    "tagline": { "type": "string", "description": "Italic one-liner under the contacts." },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dates", "institution", "location"],
        "properties": {
          "dates": { "type": "string", "description": "e.g. '2023 - 2027'." },
          "institution": { "type": "string" },
          "href": { "type": ["string", "null"], "description": "Optional link on the institution name." },
          "location": { "type": "string", "description": "Right-aligned, bold." },
          "bullets": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end", "company", "role", "location", "bullets"],
        "properties": {
          "start": { "type": "string", "description": "e.g. \"Apr'26\"." },
          "end": { "type": "string", "description": "e.g. \"Jul'26\". Rendered as start -<br>end." },
          "company": { "type": "string" },
          "href": { "type": ["string", "null"], "description": "Optional link on the company name (blue underline)." },
          "note": { "type": ["string", "null"], "description": "Italic parenthetical after the company." },
          "role": { "type": "string", "description": "Bold role title." },
          "location": { "type": "string" },
          "bullets": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "labeled": {
      "type": "array",
      "description": "Trailing labeled rows (Skills / Extra Curricular / Personal). Label sits in the left column. A single bullet renders as a plain line, multiple as a disc list.",
      "items": {
        "type": "object",
        "required": ["label", "bullets"],
        "properties": {
          "label": { "type": "string" },
          "bullets": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
